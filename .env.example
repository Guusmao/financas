VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ======== SERVIDOR APENAS (Vercel) ========
# Nunca expose estas variáveis no frontend!

# Pluggy API
PLUGGY_CLIENT_ID=your_pluggy_client_id
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret

# Supabase Admin (SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=your_supabase_project_url

# App Owner e Secrets
APP_OWNER_USER_ID=your_supabase_user_id
SETUP_SECRET=your_random_setup_secret
PLUGGY_WEBHOOK_SECRET=your_random_webhook_secret

# URLs e Datas
APP_URL=https://your-vercel-domain.app
PLUGGY_SYNC_FROM_DATE=2024-01-01
